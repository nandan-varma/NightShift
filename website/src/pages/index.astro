---
import Layout from "../layouts/Layout.astro";

const features = [
  {
    title: "Sunrise & sunset, automatically",
    body: "NightShift calculates sunrise and sunset for your location offline and eases your display's color temperature to match — no network required after setup.",
  },
  {
    title: "Full manual control",
    body: "Switch between Auto, Day, Night, or Off straight from the menu bar whenever you want to override the schedule.",
  },
  {
    title: "Bedtime wind-down",
    body: "An optional extra taper gradually warms your display in the hour before bedtime — the window that matters most for winding down.",
  },
  {
    title: "Tune it your way",
    body: "Set exact day and night color temperatures and how long the transition takes, with a live preview as you adjust.",
  },
  {
    title: "Launch at login",
    body: "Turn it on once and NightShift quietly starts with your Mac from then on.",
  },
  {
    title: "Private by design",
    body: "No accounts, no analytics, no tracking. Your settings live in UserDefaults on your Mac and nowhere else.",
  },
];
---

<Layout
	title="NightShift — warm your Mac's display with the sun"
	description="NightShift is a native macOS menu bar app that automatically shifts your display's color temperature between day and night, with a manual mode and a bedtime wind-down."
>
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 -z-10">
			<div class="absolute left-1/2 top-[-10%] h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-gradient-to-br from-day-glow/20 via-amber-glow/10 to-transparent blur-3xl"></div>
		</div>

		<div class="mx-auto max-w-3xl px-6 pb-20 pt-20 text-center sm:pt-28">
			<div class="mb-8 flex justify-center">
				<img src="/icon.png" alt="NightShift app icon" width="88" height="88" class="rounded-[20px] shadow-2xl shadow-amber-glow/10" />
			</div>
			<h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
				Warmer nights.<br class="hidden sm:block" /> Sharper mornings.
			</h1>
			<p class="mx-auto mt-5 max-w-xl text-balance text-lg text-slate-400">
				NightShift lives quietly in your menu bar and shifts your Mac's display color temperature with the sun — calmer evenings, crisp mornings, zero fuss.
			</p>
			<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href="#download"
					class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-night-950 transition hover:bg-slate-200"
				>
					Download on the Mac App Store
				</a>
				<a
					href="#features"
					class="rounded-full border border-white/10 px-6 py-3 text-sm font-semibold text-slate-300 transition hover:border-white/25 hover:text-white"
				>
					See how it works
				</a>
			</div>
			<p class="mt-4 text-xs text-slate-500">Free · macOS 14 Sonoma or later · No account required</p>
		</div>

		<div class="mx-auto max-w-lg px-6 pb-24">
			<div class="rounded-2xl border border-white/10 bg-night-900/80 p-5 shadow-2xl shadow-black/40 backdrop-blur">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="h-9 w-9 rounded-full bg-gradient-to-br from-day-glow to-amber-glow"></div>
						<div>
							<p class="text-sm font-medium text-white">4,200K</p>
							<p class="text-xs text-slate-500">Transitioning to Night</p>
						</div>
					</div>
					<span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-400">Auto</span>
				</div>

				<div class="mt-5 grid grid-cols-4 gap-1.5 rounded-lg bg-white/5 p-1 text-xs">
					{["Auto", "Day", "Night", "Off"].map((mode, i) => (
						<div class={`rounded-md py-1.5 text-center ${i === 0 ? "bg-white text-night-950 font-medium" : "text-slate-400"}`}>{mode}</div>
					))}
				</div>

				<div class="mt-5 space-y-3">
					<div>
						<div class="mb-1.5 flex justify-between text-xs text-slate-500">
							<span>Day</span><span>6500K</span>
						</div>
						<div class="h-1.5 rounded-full bg-white/5">
							<div class="h-full w-4/5 rounded-full bg-day-glow/70"></div>
						</div>
					</div>
					<div>
						<div class="mb-1.5 flex justify-between text-xs text-slate-500">
							<span>Night</span><span>2700K</span>
						</div>
						<div class="h-1.5 rounded-full bg-white/5">
							<div class="h-full w-2/5 rounded-full bg-amber-glow/70"></div>
						</div>
					</div>
				</div>

				<div class="mt-5 flex items-center justify-between border-t border-white/5 pt-4 text-xs text-slate-500">
					<span>Bedtime wind-down</span>
					<span class="rounded-full bg-amber-glow/15 px-2 py-0.5 text-amber-glow">On</span>
				</div>
			</div>
			<p class="mt-3 text-center text-xs text-slate-600">Illustrative preview of the menu bar popover</p>
		</div>
	</section>

	<section id="features" class="mx-auto max-w-5xl px-6 py-16">
		<div class="mb-12 text-center">
			<h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Everything f.lux does. Nothing it doesn't.</h2>
			<p class="mx-auto mt-3 max-w-xl text-slate-400">A small, native utility that does one thing well.</p>
		</div>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{features.map((feature) => (
				<div class="rounded-xl border border-white/5 bg-night-900/50 p-6">
					<h3 class="text-sm font-semibold text-white">{feature.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-400">{feature.body}</p>
				</div>
			))}
		</div>
	</section>

	<section id="download" class="mx-auto max-w-3xl px-6 py-20 text-center">
		<h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Get NightShift</h2>
		<p class="mx-auto mt-3 max-w-md text-slate-400">Available on the Mac App Store for macOS 14 Sonoma and later.</p>
		<div class="mt-8 flex justify-center">
			<a
				href="#"
				class="rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-night-950 transition hover:bg-slate-200"
			>
				Download on the Mac App Store
			</a>
		</div>
	</section>
</Layout>
