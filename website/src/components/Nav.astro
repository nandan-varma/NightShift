---
const links = [
  { href: "/#features", label: "Features" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy" },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-night-950/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2.5">
			<img src="/icon.png" alt="" width="28" height="28" class="rounded-[7px]" />
			<span class="text-sm font-semibold tracking-tight text-white">NightShift</span>
		</a>
		<nav class="flex items-center gap-6 text-sm text-slate-400">
			{links.map((link) => (
				<a href={link.href} class="transition hover:text-white">{link.label}</a>
			))}
		</nav>
	</div>
</header>
